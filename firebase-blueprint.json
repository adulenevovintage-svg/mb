{
  "entities": {
    "Reservation": {
      "title": "Reservation",
      "description": "A booking for a barber service",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Customer's full name" },
        "email": { "type": "string", "format": "email", "description": "Customer's email address" },
        "phone": { "type": "string", "description": "Customer's phone number with prefix" },
        "service": { "type": "string", "description": "The grooming service selected" },
        "date": { "type": "string", "format": "date", "description": "Date of the appointment" },
        "time": { "type": "string", "description": "Time of the appointment" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the reservation was made" }
      },
      "required": ["name", "email", "phone", "date", "time"]
    }
  },
  "firestore": {
    "reservations": {
      "schema": "Reservation",
      "description": "Collection of all barber shop bookings"
    }
  }
}
